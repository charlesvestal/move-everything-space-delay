{
 "id": "tapedelay",
 "name": "Tape Echo 2",
 "abbrev": "TE2",
 "version": "1.3.5",
 "description": "Component-modeled vintage three-head tape echo with spring reverb: 12 head/reverb modes, tape saturation, wow & flutter, tape age, tempo sync.",
 "author": "Tape Echo 2 by Dusk Audio (GPL-3.0); port: athousanddetails, charlesvestal",
 "dsp": "tapedelay.so",
 "ui_chain": "ui_chain.js",
 "api_version": 2,
 "component_type": "audio_fx",
 "capabilities": {
  "audio_out": true,
  "audio_in": true,
  "midi_in": false,
  "midi_out": false,
  "chainable": true,
  "component_type": "audio_fx",
  "chain_params": [
   {
    "key": "mode",
    "name": "Mode",
    "type": "enum",
    "options": [
     "H1",
     "H2",
     "H3",
     "H2+3",
     "H1+R",
     "H2+R",
     "H3+R",
     "H12+R",
     "H23+R",
     "H13+R",
     "H123R",
     "Rev"
    ],
    "default": "H3"
   },
   {
    "key": "repeat_rate",
    "name": "Repeat Rate",
    "type": "float",
    "min": 0,
    "max": 1,
    "default": 0.414888
   },
   {
    "key": "intensity",
    "name": "Intensity",
    "type": "float",
    "min": 0,
    "max": 1,
    "default": 0.44
   },
   {
    "key": "echo_volume",
    "name": "Echo Volume",
    "type": "float",
    "min": 0,
    "max": 1,
    "default": 1
   },
   {
    "key": "reverb_volume",
    "name": "Reverb Volume",
    "type": "float",
    "min": 0,
    "max": 1,
    "default": 0
   },
   {
    "key": "mix",
    "name": "Mix",
    "type": "float",
    "min": 0,
    "max": 1,
    "default": 0.5
   },
   {
    "key": "tempo_sync",
    "name": "Tempo Sync",
    "type": "enum",
    "options": [
     "Off",
     "On"
    ],
    "default": "Off"
   },
   {
    "key": "echo_rate_note",
    "name": "Echo Rate Note",
    "type": "int",
    "min": 1,
    "max": 11,
    "default": 5
   },
   {
    "key": "input_volume",
    "name": "Input Drive",
    "type": "float",
    "min": 0,
    "max": 1,
    "default": 0.5
   },
   {
    "key": "bass",
    "name": "Bass",
    "type": "float",
    "min": -1,
    "max": 1,
    "default": 0
   },
   {
    "key": "treble",
    "name": "Treble",
    "type": "float",
    "min": -1,
    "max": 1,
    "default": 0
   },
   {
    "key": "wow_flutter",
    "name": "Wow & Flutter",
    "type": "float",
    "min": 0,
    "max": 1,
    "default": 0
   },
   {
    "key": "tape_age",
    "name": "Tape Age",
    "type": "enum",
    "options": [
     "New",
     "Used",
     "Old"
    ],
    "default": "Used"
   },
   {
    "key": "input_send",
    "name": "Input Send",
    "type": "enum",
    "options": [
     "Off",
     "On"
    ],
    "default": "On"
   },
   {
    "key": "ping_pong",
    "name": "Ping Pong",
    "type": "enum",
    "options": [
     "Off",
     "On"
    ],
    "default": "Off"
   },
   {
    "key": "stereo_width",
    "name": "Stereo Width",
    "type": "int",
    "min": 0,
    "max": 100,
    "default": 0
   }
  ]
 }
}
